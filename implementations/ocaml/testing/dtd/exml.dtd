<!ELEMENT doc (title?, author?, abstract?, doc_main, refs?)>

<!ELEMENT title (#PCDATA)>
<!ELEMENT author (#PCDATA)>
<!ELEMENT abstract (blk_txt+)>
<!ELEMENT doc_main (ch+ | sec+ | par+ | (blk_txt | blk_blt | blk_itm | blk_dsp)+)>
<!ELEMENT refs (blk_txt | blk_blt | blk_itm | blk_dsp)+>

<!ELEMENT ch (((ch_lbl, ch_hdr) | ch_lbl_hdr), ch_main)>
<!ATTLIST ch 
	tag CDATA #IMPLIED
	id CDATA #IMPLIED
>

<!ELEMENT sec (sec_lbl, (sec_hdr | sec_lbl_hdr), sec_main)>
<!ATTLIST sec 
	tag CDATA #IMPLIED
	id CDATA #IMPLIED
>

<!ELEMENT par (par_lbl, (par_hdr | par_lbl_hdr), par_main)>
<!ATTLIST par 
	tag CDATA #IMPLIED
	id CDATA #IMPLIED
>

<!ELEMENT ch_main (sec+ | par+ | (blk_txt | blk_blt | blk_itm | blk_dsp)+)>
<!ELEMENT sec_main (par+ | (blk_txt | blk_blt | blk_itm | blk_dsp)+)>
<!ELEMENT par_main (blk_txt | blk_blt | blk_itm | blk_dsp)+>

<!ELEMENT blk_txt (txt_unit_wysiwyg | txt_unit_emph | txt_unit_c_ref)+>
<!ELEMENT blk_blt (blk_blt_lbl, blk_blt_main)>
<!ELEMENT blk_itm (blk_itm_lbl, blk_itm_main)>
<!ATTLIST blk_itm 
	tag CDATA #IMPLIED
	id CDATA #IMPLIED
>

<!ELEMENT blk_dsp (dsp_line+)>

<!ELEMENT blk_blt_main (blk_txt | blk_blt | blk_itm | blk_dsp)+>
<!ELEMENT blk_itm_main (blk_txt | blk_blt | blk_itm | blk_dsp)+>

<!ELEMENT ch_hdr ((txt_unit_wysiwyg | txt_unit_emph | txt_unit_c_ref)+)>
<!ELEMENT sec_hdr ((txt_unit_wysiwyg | txt_unit_emph | txt_unit_c_ref)+)>
<!ELEMENT par_hdr ((txt_unit_wysiwyg | txt_unit_emph | txt_unit_c_ref)+)>

<!ELEMENT ch_lbl (#PCDATA)>
<!ELEMENT ch_lbl_hdr (#PCDATA)>
<!ELEMENT sec_lbl (#PCDATA)>
<!ELEMENT sec_lbl_hdr (#PCDATA)>
<!ELEMENT par_lbl (#PCDATA)>
<!ELEMENT par_lbl_hdr (#PCDATA)>
<!ELEMENT blk_blt_lbl (#PCDATA)>
<!ELEMENT blk_itm_lbl (#PCDATA)>
<!ELEMENT dsp_line_lbl (#PCDATA)>

<!ELEMENT txt_unit_wysiwyg (#PCDATA)>
<!ELEMENT txt_unit_emph (#PCDATA)>
<!ELEMENT txt_unit_c_ref (#PCDATA)>
<!ATTLIST txt_unit_c_ref href CDATA #REQUIRED>

<!ELEMENT dsp_line (dsp_line_lbl?, dsp_line_main)+>
<!ATTLIST dsp_line 
	tag CDATA #IMPLIED
	id CDATA #IMPLIED
>

<!ELEMENT dsp_line_main (txt_unit_wysiwyg | txt_unit_emph | txt_unit_c_ref)+>

