#! /usr/bin/env python3.13

# IMPORTS

import os.path
import pathlib
import subprocess
import sys
import tempfile
import typing

from typing import Annotated, Final as F, Literal, TypeAlias as TA

import typer

# HELPER _GET_PATH_TO_FILE

def _get_path_to_file(filename:str) -> str:
  return str(
    os.path.join(
      os.path.dirname(os.path.realpath(__file__)),
      filename,
    )
  )

# CREATE TYPER OBJECT _CLI

_cli : F[typer.Typer] = typer.Typer(no_args_is_help=True)

# TYPE ALIASES AND DEFAULT VALUES FOR OPTIONS

## --PARSER-BACKEND

_ta_parser_backend : TA = Annotated[
  Literal['Mercury','OCaml'],
  typer.Option(
    '--parser-backend',
    case_sensitive = False,
    help           =
      'Parser implementation to use. The OCaml implementation is faster but experimental.',
  )
]

_default_parser_backend : F[str] = 'Mercury'

## --TAGS-FILE

_ta_tags_file : TA = Annotated[
  pathlib.Path,
  typer.Option(
    '--tags-file',
    mode         = 'r',
    exists       = True,
    dir_okay     = False,
    resolve_path = True,
    help         = 'Use tags from tab-separated-values file.'
  )
]
_default_tags_file : F[pathlib.Path] = \
  pathlib.Path(_get_path_to_file('tags.tsv'))


## ---MARGIN

_ta_margin : TA = Annotated[
  int,
  typer.Option(
    '--margin',
    min = 0,
    help =
      'Set margin width to MARGIN := x spaces.'
      +
      ' '
      +
      'MARGIN = 0 means margin is automatically computed to be as small as possible.',
  )
]

_default_margin : F[int] = 11

## --TEXT-WIDTH

_ta_text_width : TA = Annotated[
  int,
  typer.Option(
    '--text-width',
    min = 0,
    help =
      'Set body text width to WIDTH := x spaces.'
      +
      ' '
      +
      'Totalt width becomes MARGIN+WIDTH.',
  )
]

_default_text_width : F[int] = 69

## --NUMBERING

_ta_numbering : TA = Annotated[
 Literal['a1i','ai1','1ai','1ia','ia1','i1a'],
  typer.Option(
    '--numbering',
    help ='Set numbering logic for item blocks and displayed blocks.',
  )
]

_default_numbering : F[str] = 'a1i'

## --ALLOW_CUSTOM_NUMBERING

_ta_custom_numbering : TA = \
  Annotated[bool,typer.Option('--allow-custom-numbering')]

_default_custom_numbering : F[bool] = False

## --QUITE

_ta_quite      : TA      = Annotated[bool,typer.Option('--quite')]
_default_quite : F[bool] = False

# TYPE ALIAS FOR INPUT PATH

_ta_input_path : TA = Annotated[
  pathlib.Path,
  typer.Argument(
    mode         = 'r',
    exists       = True,
    dir_okay     = False,
    resolve_path = True,
  )
]

# SUBCOMMAND NMM2TXT

@_cli.command(no_args_is_help=True)
def nmm2txt(
  path                   : _ta_input_path,
  parser_backend         : _ta_parser_backend   = _default_parser_backend,
  margin                 : _ta_margin           = _default_margin,
  text_width             : _ta_text_width       = _default_text_width,
  numbering              : _ta_numbering        = _default_numbering,
  allow_custom_numbering : _ta_custom_numbering = _default_custom_numbering,
  tags_file              : _ta_tags_file        = _default_tags_file,
  quite                  : _ta_quite            = _default_quite,
):
  """
  Print raw text semantics of nmm source file at PATH.
  """
  match parser_backend:
    case 'Mercury':
      tmp_xml_file_path : F[str] = tempfile.mkstemp()[1]
      with open(tmp_xml_file_path,'w') as f:
        exit_code_nmm2xml : F[int] = _nmm2xml(path,parser_backend,tags_file,f)
      if exit_code_nmm2xml != 0:
        os.remove(tmp_xml_file_path)
        sys.exit(exit_code_nmm2xml)
      exit_code_xml2txt : F[int] = _xml2txt(
        tmp_xml_file_path,
        margin,
        text_width,
        numbering,
        allow_custom_numbering,
        tags_file,
        quite,
      )
      os.remove(tmp_xml_file_path)
      sys.exit(exit_code_xml2txt)
    case 'OCaml':
      completed_proc : F[subprocess.CompletedProcess[bytes]] = subprocess.run(
        [_get_path_to_file('nmm-ocaml'),'txt-of-nmm']
        +
        ([] if margin == 0 else ['--margin',str(margin)])
        +
        ['--width',    str(text_width)]
        +
        ['--numbering',str(numbering)]
        +
        (['--allow-custom-numbering'] if allow_custom_numbering else [])
        +
        (['--quite']                  if quite                  else [])
        +
        [path],
      )
      sys.exit(completed_proc.returncode)

# SUBCOMMAND NMM2XML

@_cli.command(no_args_is_help=True)
def nmm2xml(
  path           : _ta_input_path,
  parser_backend : _ta_parser_backend = _default_parser_backend,
  tags_file      : _ta_tags_file      = _default_tags_file,
):
  """
  Print XML semantics of nmm source file at PATH.
  """
  sys.exit(_nmm2xml(path,parser_backend,tags_file,sys.stdout))

# SUBCOMMAND XML2TXT

@_cli.command(no_args_is_help=True)
def xml2txt(
  path                   : _ta_input_path,
  margin                 : _ta_margin           = _default_margin,
  text_width             : _ta_text_width       = _default_text_width,
  numbering              : _ta_numbering        = _default_numbering,
  allow_custom_numbering : _ta_custom_numbering = _default_custom_numbering,
  tags_file              : _ta_tags_file        = _default_tags_file,
  quite                  : _ta_quite            = _default_quite,
):
  """
  Print raw text semantics of XML-semantics-file at PATH.
  """
  sys.exit(_xml2txt(
    str(path),
    margin,
    text_width,
    numbering,
    allow_custom_numbering,
    tags_file,
    quite,
  ))

# SUBCOMMAND LEX2TXT

@_cli.command(no_args_is_help=True)
def lex2txt(path:_ta_input_path):
  """
  Print a raw text representation of the Mercury backend's lexing of nmm source
  file at PATH.
  """
  sys.exit(
    subprocess.run([_get_path_to_file('nmm-mercury'),'lex2txt',path]).returncode
  )

# SUBCOMMAND VALIDATE_XML

@_cli.command(no_args_is_help=True,name='validate-xml')
def validate_xml(path:_ta_input_path):
  """
  Check whether the XML file at PATH represents the AST of an nmm source.
  """
  completed_proc : F[subprocess.CompletedProcess[bytes]] = subprocess.run([
    _get_path_to_file('nmm-ocaml'),
    'validate-xml',
    _get_path_to_file('AST.dtd'),
    path
  ])
  sys.exit(completed_proc.returncode)

# SUBCOMMAND NORMALIZE_XML

@_cli.command(no_args_is_help=True,name='normalize-xml')
def normalize_xml(path:_ta_input_path):
  """
  Print normalized version of XML-semantics-file at PATH.
  """
  completed_proc : F[subprocess.CompletedProcess[bytes]] = subprocess.run(
    [_get_path_to_file('nmm-ocaml'),'normalize-axml',path]
  )
  sys.exit(completed_proc.returncode)

# HELPER _NMM2XML

def _nmm2xml(
  path           : _ta_input_path,
  parser_backend : _ta_parser_backend,
  tags_file      : _ta_tags_file,
  out            : typing.TextIO,
) -> int:
  """
  Print XML semantics of nmm source file at PATH.
  """
  match parser_backend:
    case 'Mercury':
      bin_name           : F[str]       = 'nmm-mercury' # pyright: ignore reportGeneralTypeIssues
      cmd_name           : F[str]       = 'nmm2xml'     # pyright: ignore reportGeneralTypeIssues
      tags_file_arg_list : F[list[str]] = []            # pyright: ignore reportGeneralTypeIssues
      if os.path.abspath(tags_file) != os.path.abspath(_default_tags_file):
        print(
          '--tags-file non-default value not yet supported for Mercury parser.',
          file=sys.stderr,
        )
        return 1
    case 'OCaml':
      bin_name : F[str] = 'nmm-ocaml'                           # pyright: ignore reportGeneralTypeIssues
      cmd_name : F[str] = 'axml-of-nmm'                         # pyright: ignore reportGeneralTypeIssues
      tags_file_arg_list : F[list[str]] = ['--tags', tags_file] # pyright: ignore reportGeneralTypeIssues
  completed_proc : F[subprocess.CompletedProcess[bytes]] = subprocess.run(
    [_get_path_to_file(bin_name),cmd_name]+tags_file_arg_list+[path],stdout=out
  )
  return completed_proc.returncode

# HELPER _XML2TXT

def _xml2txt(
  path                   : str,
  margin                 : _ta_margin,
  text_width             : _ta_text_width,
  numbering              : _ta_numbering,
  allow_custom_numbering : _ta_custom_numbering,
  tags_file              : _ta_tags_file,
  quite                  : _ta_quite,
) -> int:
  completed_proc : F[subprocess.CompletedProcess[bytes]] = subprocess.run(
    [_get_path_to_file('nmm-ocaml'),'txt-of-axml']
    +
    ([] if margin == 0 else ['--margin',str(margin)])
    +
    ['--width',    str(text_width)]
    +
    ['--numbering',str(numbering)]
    +
    ['--tags',    tags_file]
    +
    (['--allow-custom-numbering'] if allow_custom_numbering else [])
    +
    (['--quite']                  if quite                  else [])
    +
    [path],
  )
  return completed_proc.returncode

# MAIN

if __name__ == '__main__':
  _cli()
